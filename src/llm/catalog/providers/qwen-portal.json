{
  "id": "qwen-portal",
  "defaultModel": "coder-model",
  "env": [
    "QWEN_OAUTH_TOKEN",
    "QWEN_PORTAL_API_KEY"
  ],
  "api": "openai-completions",
  "baseUrl": "https://portal.qwen.ai/v1",
  "discovery": {
    "allowUnauthenticated": false
  },
  "seed": [
    {
      "id": "coder-model",
      "name": "Qwen Coder",
      "reasoning": false,
      "input": [
        "text"
      ],
      "contextWindow": 128000,
      "maxTokens": 8192,
      "cost": {
        "input": 0,
        "output": 0,
        "cacheRead": 0,
        "cacheWrite": 0
      }
    },
    {
      "id": "vision-model",
      "name": "Qwen Vision",
      "reasoning": false,
      "input": [
        "text",
        "image"
      ],
      "contextWindow": 128000,
      "maxTokens": 8192,
      "cost": {
        "input": 0,
        "output": 0,
        "cacheRead": 0,
        "cacheWrite": 0
      }
    }
  ]
}
